{
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "dark": "One Dark",
    "light": "One Light"
  },
  "tab_size": 2,
  "relative_line_numbers": true,
  "soft_wrap": "editor_width",
  "format_on_save": "on",
  "formatter": "auto",
  "code_actions_on_format": {
    "source.fixAll": true,
    "source.organizeImports": true
  },
  "terminal": {
    "working_directory": "current_project_directory"
  },
  "file_types": {
    "*.pine": "PineScript",
    "*.ps1": "PowerShell",
    "*.jsonc": "JSON",
    "*.yaml": "YAML",
    "*.yml": "YAML",
    "*.toml": "TOML"
  },
  "languages": {
    "JSON": {
      "tab_size": 2,
      "format_on_save": "on"
    },
    "JSONC": {
      "tab_size": 2,
      "format_on_save": "on"
    }
  }
}
