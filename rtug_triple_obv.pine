b_div1_disp = f_normDisp(b_div1, b_obvNormLen)
plot(b_div1_disp + offsetB, title="B: Div1",
     color=dynC(b_div1_disp, b_c_div1_up, b_c_div1_down), linewidth=2, style=plot.style_line)

