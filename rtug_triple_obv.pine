a_c_div5_down = input.color(color.rgb(255, 120,   0), title="A: Div5 ↓",              group="🎨 Bant A Renkleri")
a_c_div6_up   = input.color(color.rgb(  0, 170, 255), title="A: Div6 ↑ (Blue/Hızlı)",group="🎨 Bant A Renkleri")
a_c_div6_down = input.color(color.rgb(  0, 255, 240), title="A: Div6 ↓",              group="🎨 Bant A Renkleri")
a_rev_transp  = input.int(40, minval=0, maxval=99,    title="A: Reverse Div Şeffaflık", group="🎨 Bant A Renkleri")

// ═══════════════════════════════════════════════════════════
// 🎨 BANT B — RENK PANELİ
// ═══════════════════════════════════════════════════════════
b_c_hist_up   = input.color(color.rgb( 60, 255, 130), title="B: Hist ↑ Renk",        group="🎨 Bant B Renkleri")
b_c_hist_down = input.color(color.rgb(255,  45,  85), title="B: Hist ↓ Renk",        group="🎨 Bant B Renkleri")
b_c_norm_up   = input.color(color.rgb(255, 225,  40), title="B: OBV Norm ↑ Renk",    group="🎨 Bant B Renkleri")
b_c_norm_down = input.color(color.rgb( 50, 245, 255), title="B: OBV Norm ↓ Renk",    group="🎨 Bant B Renkleri")


b_c_trigger   = input.color(color.rgb(  0, 255, 195), title="B: Trigger Renk",        group="🎨 Bant B Renkleri")
b_c_div1_up   = input.color(color.rgb(255,  45, 200), title="B: Div1 ↑ (Pink)",       group="🎨 Bant B Renkleri")
b_c_div1_down = input.color(color.rgb(255, 100, 220), title="B: Div1 ↓",              group="🎨 Bant B Renkleri")
b_c_div2_up   = input.color(color.rgb(180,  60, 255), title="B: Div2 ↑ (Purple)",     group="🎨 Bant B Renkleri")
b_c_div2_down = input.color(color.rgb(220, 120, 255), title="B: Div2 ↓",              group="🎨 Bant B Renkleri")
b_c_div3_up   = input.color(color.rgb( 60, 255, 130), title="B: Div3 ↑ (Green)",      group="🎨 Bant B Renkleri")
b_c_div3_down = input.color(color.rgb(180, 255,   0), title="B: Div3 ↓",              group="🎨 Bant B Renkleri")
b_c_div4_up   = input.color(color.rgb(255, 150,  30), title="B: Div4 ↑ (Orange)",     group="🎨 Bant B Renkleri")
b_c_div4_down = input.color(color.rgb(255, 220,   0), title="B: Div4 ↓",              group="🎨 Bant B Renkleri")
b_c_div5_up   = input.color(color.rgb(255,  45,  85), title="B: Div5 ↑ (Red/Hızlı)", group="🎨 Bant B Renkleri")
b_c_div5_down = input.color(color.rgb(255, 120,   0), title="B: Div5 ↓",              group="🎨 Bant B Renkleri")
b_c_div6_up   = input.color(color.rgb(  0, 170, 255), title="B: Div6 ↑ (Blue/Hızlı)",group="🎨 Bant B Renkleri")
b_c_div6_down = input.color(color.rgb(  0, 255, 240), title="B: Div6 ↓",              group="🎨 Bant B Renkleri")
b_rev_transp  = input.int(40, minval=0, maxval=99,    title="B: Reverse Div Şeffaflık", group="🎨 Bant B Renkleri")

// ═══════════════════════════════════════════════════════════
// ⚙️ PANEL BÖLME + ORTAK FONKSİYONLAR
// ═══════════════════════════════════════════════════════════
bandGap = input.float(300, title="Bant Merkez Aralığı", group="⚙ Panel Bölme")
offsetA = bandGap
offsetB = 0.0
offsetC = -bandGap

f_normDisp(_val, _len) =>
    _hi = ta.highest(_val, _len)
    _lo = ta.lowest(_val, _len)
    (_val - _lo) / (_hi - _lo + 1e-9) * 200 - 100

f_obvMain(_np, _tsp) =>
    _chg  = ta.change(close)
    _raw  = ta.cum(_chg > 0 ? volume : _chg < 0 ? -volume : 0)
    _norm = (_raw - ta.lowest(_raw, _np)) / (ta.highest(_raw, _np) - ta.lowest(_raw, _np) + 0.000001) * 2 - 1
    _norm2 = _np < 2 ? _raw : _norm
    _trig  = ta.wma(_norm2, _tsp)
    _hist2 = math.max(math.min(_norm2 - _trig, 1), -1)
    [_norm2, _trig, _hist2]

f_obvDiv(_src, _lenFast, _lenSlow) =>
    _chg = ta.change(_src)
    _obv = ta.cum(_chg > 0 ? volume : _chg < 0 ? -volume : 0)
    _fast = ta.rma(_obv, _lenFast)
    _slow = ta.rma(_obv, _lenSlow)
    [_obv, _fast - _slow]

f_revDiv(_obv, _lenFast, _lenSlow) =>
    ta.rma(_obv, _lenFast) - ta.rma(_obv, _lenSlow)

// ════════════════════════════════════════════════════════════
// BÖLÜM A — OBV #1 (ÜST BANT)
// ════════════════════════════════════════════════════════════
a_np  = input(20,  title='A: Normalize', group="A: OBV #1 (Üst Bant)")
a_tsp = input(9,   title='A: Trigger',   group="A: OBV #1 (Üst Bant)")
a_h      = input(true,  title='A: Histogram',    group="A: OBV #1 (Üst Bant)")
a_docol  = input(true,  title='A: Color Change', group="A: OBV #1 (Üst Bant)")
a_obvNormLen = input.int(200, minval=10, title="A: Ham Diverjans Normalize Periyodu", group="A: OBV #1 (Üst Bant)")

[a_obv_norm2, a_Trigger, a_Hist2] = f_obvMain(a_np, a_tsp)

// — A: Temel çizgiler —
plot((a_h ? a_Hist2 : na) * 100 + offsetA,
     color     = dynC(a_Hist2, a_c_hist_up, a_c_hist_down),
     style     = plot.style_line, linewidth=2, title='A: Hist')

plot(a_obv_norm2 * 100 + offsetA,
     color     = a_docol ? dynC(a_obv_norm2, a_c_norm_up, a_c_norm_down) : a_c_norm_down,
     style     = plot.style_line, title='A: OBV Norm')


plot(a_Trigger * 100 + offsetA,
     color     = a_c_trigger,
     style     = plot.style_line, title='A: Trigger')

// — A: Div1 —
a_src1 = input.source(close, title="A: OBV Source #1", group="A: OBV #1 (Üst Bant)")
a_lf1  = input.int(100, minval=1, title="A: Length Fast MA #1", group="A: OBV #1 (Üst Bant)")
a_ls1  = input.int(20,  minval=1, title="A: Length Slow MA #1", group="A: OBV #1 (Üst Bant)")
[a_o1, a_div1] = f_obvDiv(a_src1, a_lf1, a_ls1)
a_div1_disp = f_normDisp(a_div1, a_obvNormLen)
plot(a_div1_disp + offsetA, title="A: Div1",
     color=dynC(a_div1_disp, a_c_div1_up, a_c_div1_down), linewidth=2, style=plot.style_line)

// — A: Div2 —
a_src2 = input.source(close, title="A: OBV Source #2", group="A: OBV #1 (Üst Bant)")
a_lf2  = input.int(70, minval=1, title="A: Length Fast MA #2", group="A: OBV #1 (Üst Bant)")
a_ls2  = input.int(15, minval=1, title="A: Length Slow MA #2", group="A: OBV #1 (Üst Bant)")
[a_o2, a_div2] = f_obvDiv(a_src2, a_lf2, a_ls2)
a_div2_disp = f_normDisp(a_div2, a_obvNormLen)
plot(a_div2_disp + offsetA, title="A: Div2",
     color=dynC(a_div2_disp, a_c_div2_up, a_c_div2_down), linewidth=2, style=plot.style_line)

// — A: Div3 —
a_src3 = input.source(close, title="A: OBV Source #3", group="A: OBV #1 (Üst Bant)")
a_lf3  = input.int(50, minval=1, title="A: Length Fast MA #3", group="A: OBV #1 (Üst Bant)")
a_ls3  = input.int(20, minval=1, title="A: Length Slow MA #3", group="A: OBV #1 (Üst Bant)")
[a_o3, a_div3] = f_obvDiv(a_src3, a_lf3, a_ls3)
a_div3_disp = f_normDisp(a_div3, a_obvNormLen)
plot(a_div3_disp + offsetA, title="A: Div3",
     color=dynC(a_div3_disp, a_c_div3_up, a_c_div3_down), linewidth=2, style=plot.style_line)

// — A: Div4 —
a_src4 = input.source(close, title="A: OBV Source #4", group="A: OBV #1 (Üst Bant)")
a_lf4  = input.int(30, minval=1, title="A: Length Fast MA #4", group="A: OBV #1 (Üst Bant)")
a_ls4  = input.int(12, minval=1, title="A: Length Slow MA #4", group="A: OBV #1 (Üst Bant)")
[a_o4, a_div4] = f_obvDiv(a_src4, a_lf4, a_ls4)
a_div4_disp = f_normDisp(a_div4, a_obvNormLen)
