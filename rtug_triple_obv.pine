a_c_div1_down = input.color(color.rgb(255, 100, 220), title="A: Div1 ↓",              group="🎨 Bant A Renkleri")
a_c_div2_up   = input.color(color.rgb(180,  60, 255), title="A: Div2 ↑ (Purple)",     group="🎨 Bant A Renkleri")
a_c_div2_down = input.color(color.rgb(220, 120, 255), title="A: Div2 ↓",              group="🎨 Bant A Renkleri")
