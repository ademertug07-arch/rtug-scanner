a_lf5  = input.int(15, minval=1, title="A: Length Fast MA #5", group="A: OBV #1 (Üst Bant)")
a_ls5  = input.int(5,  minval=1, title="A: Length Slow MA #5", group="A: OBV #1 (Üst Bant)")
