//@version=5
indicator('☪RTUĞ ✯ [OBV-A + OBV-B + SURGE PULSE ΔΨ — NEON] ☪RTUĞ ✯', shorttitle='RTUĞ TRIPLE OBV/ΔΨ', overlay=false)

// ═══════════════════════════════════════════════════════════
// 🖌️ DİNAMİK RENK YARDIMCI FONKSİYONLARI
// ═══════════════════════════════════════════════════════════
dynC(val, cu, cd)     => val > val[1] ? cu : cd
dynCA(val, cu, cd, t) => val > val[1] ? color.new(cu, t) : color.new(cd, t)

// ═══════════════════════════════════════════════════════════
