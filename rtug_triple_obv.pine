a_ls1r = input.int(100, minval=1, title="A: Reverse Slow MA #1 (100)", group="A: OBV #1 (Üst Bant)")
a_div1r = f_revDiv(a_o1, a_lf1r, a_ls1r)
plot(f_normDisp(a_div1r, a_obvNormLen) + offsetA, title="A: Reverse Div1",
     color=dynCA(f_normDisp(a_div1r, a_obvNormLen), a_c_div1_up, a_c_div1_down, a_rev_transp), style=plot.style_line)

a_lf2r = input.int(15, minval=1, title="A: Reverse Fast MA #2 (15)", group="A: OBV #1 (Üst Bant)")
a_ls2r = input.int(70, minval=1, title="A: Reverse Slow MA #2 (70)", group="A: OBV #1 (Üst Bant)")
a_div2r = f_revDiv(a_o2, a_lf2r, a_ls2r)
plot(f_normDisp(a_div2r, a_obvNormLen) + offsetA, title="A: Reverse Div2",
     color=dynCA(f_normDisp(a_div2r, a_obvNormLen), a_c_div2_up, a_c_div2_down, a_rev_transp), style=plot.style_line)

a_lf3r = input.int(20, minval=1, title="A: Reverse Fast MA #3 (20)", group="A: OBV #1 (Üst Bant)")
a_ls3r = input.int(50, minval=1, title="A: Reverse Slow MA #3 (50)", group="A: OBV #1 (Üst Bant)")
a_div3r = f_revDiv(a_o3, a_lf3r, a_ls3r)
plot(f_normDisp(a_div3r, a_obvNormLen) + offsetA, title="A: Reverse Div3",
     color=dynCA(f_normDisp(a_div3r, a_obvNormLen), a_c_div3_up, a_c_div3_down, a_rev_transp), style=plot.style_line)

a_lf4r = input.int(12, minval=1, title="A: Reverse Fast MA #4 (12)", group="A: OBV #1 (Üst Bant)")
a_ls4r = input.int(30, minval=1, title="A: Reverse Slow MA #4 (30)", group="A: OBV #1 (Üst Bant)")
a_div4r = f_revDiv(a_o4, a_lf4r, a_ls4r)
plot(f_normDisp(a_div4r, a_obvNormLen) + offsetA, title="A: Reverse Div4",
     color=dynCA(f_normDisp(a_div4r, a_obvNormLen), a_c_div4_up, a_c_div4_down, a_rev_transp), style=plot.style_line)

a_lf5r = input.int(5,  minval=1, title="A: Reverse Fast MA #5 (5)",  group="A: OBV #1 (Üst Bant)")
a_ls5r = input.int(15, minval=1, title="A: Reverse Slow MA #5 (15)", group="A: OBV #1 (Üst Bant)")
a_div5r = f_revDiv(a_o5, a_lf5r, a_ls5r)
plot(f_normDisp(a_div5r, a_obvNormLen) + offsetA, title="A: Reverse Div5",
     color=dynCA(f_normDisp(a_div5r, a_obvNormLen), a_c_div5_up, a_c_div5_down, a_rev_transp), style=plot.style_line)

a_lf6r = input.int(3, minval=1, title="A: Reverse Fast MA #6 (3)", group="A: OBV #1 (Üst Bant)")
a_ls6r = input.int(8, minval=1, title="A: Reverse Slow MA #6 (8)", group="A: OBV #1 (Üst Bant)")
a_div6r = f_revDiv(a_o6, a_lf6r, a_ls6r)
plot(f_normDisp(a_div6r, a_obvNormLen) + offsetA, title="A: Reverse Div6",
     color=dynCA(f_normDisp(a_div6r, a_obvNormLen), a_c_div6_up, a_c_div6_down, a_rev_transp), style=plot.style_line)

