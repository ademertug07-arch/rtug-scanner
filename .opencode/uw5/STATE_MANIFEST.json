      "path": ".version-history/",
      "type": "git_backup",
      "capacity": "unlimited",
      "description": "Git-based version history of critical UW5 files",
      "remote": {
        "url": "https://github.com/ademertug07-arch/uw5-version-history.git",
        "branch": "master",
        "last_push": null,
        "auto_sync_enabled": true,
        "needs_token_update": true
      }
    },
